# EVE Traveling Merchant - Environment Configuration Template
# Copy this file to .env if you wish to set custom environment variables.
#
# NOTE: Pre-compiled binaries and source builds work 100% out-of-the-box
# with ZERO configuration. You do NOT need this file for normal operation.

# Optional: Override the default public Client ID with your custom CCP Developer Application ID.
# Leave blank or unset to use the built-in public Client ID (5793fc7aa2cb49e385d3cfb5d52061c7).
# EVE_CLIENT_ID=your_custom_client_id_here

# SECURITY NOTICE:
# Do NOT define CLIENT_SECRET! EVE Traveling Merchant uses the official CCP OAuth 2.0
# PKCE (Proof Key for Code Exchange) flow for public desktop clients.
# Client secrets are never required, never accepted, and never sent over the wire.

# Optional: Diagnostic log filter level (options: error, warn, info, debug, trace)
# Default is "info".
RUST_LOG=info

# Optional: Custom path for application data and configuration directory
# Defaults to ~/.config/eve-traveling-merchant on Linux or %APPDATA%\eve-traveling-merchant on Windows.
# EVE_CONFIG_DIR=/path/to/custom/config
